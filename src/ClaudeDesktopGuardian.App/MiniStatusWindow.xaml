<Window x:Class="ClaudeDesktopGuardian.App.MiniStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="claude-damn"
        Icon="Assets/claude-desktop-guardian.ico"
        Width="344"
        Height="182"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="claude-damn"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="OpenButton"
                        Content="打开面板"
                        Click="OpenButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,3"
                        Margin="8,0,0,0"
                        DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Text="检查中"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,12,0,5"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="出口 "
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>
                <TextBlock x:Name="ExitIpText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="  ·  网卡 "
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>
                <TextBlock x:Name="AdapterText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="WfpStatusText"
                           Text="WFP：未启用"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="  ·  "
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"/>
                <TextBlock x:Name="AccountSlotText"
                           Text="槽位：未绑定"
                           Foreground="{StaticResource AccentHoverBrush}"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="LastCheckText"
                       Grid.Row="4"
                       Text="尚未检查"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
