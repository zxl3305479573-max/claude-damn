<Window x:Class="ClaudeDesktopGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ClaudeDesktopGuardian.Core;assembly=ClaudeDesktopGuardian.Core"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude Desktop Guardian"
        Icon="Assets/claude-desktop-guardian.ico"
        Width="1180"
        Height="800"
        MinWidth="820"
        MinHeight="580"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Claude Desktop Guardian" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="VPN / DNS / WebRTC / 进程网络守护"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Margin="0,7,0,0"/>
            </StackPanel>
            <Border x:Name="ProtectionStateBorder"
                    DockPanel.Dock="Right"
                    Background="{StaticResource StatusUnknownBackgroundBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MinWidth="112"
                    Padding="16,9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ProtectionStateText"
                           Text="检查中"
                           Foreground="{StaticResource StatusUnknownBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="VPN 网卡" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock x:Name="AdapterText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="IPv4 出口" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="ExitIpText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    <TextBlock x:Name="ExitIpv6Text" Text="IPv6 出口检测中" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="8,0">
                <StackPanel><TextBlock Text="DNS" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock x:Name="DnsText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="Claude 进程" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock x:Name="ProcessText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="环境检查" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ListView x:Name="ChecksList"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="检查项" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusUnknownBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CheckStatus.Ok}">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CheckStatus.Warn}">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusWarnBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static core:CheckStatus.Fail}">
                                                                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="详情" Width="430">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="实时数据" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="WebRTC STUN" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,20,0,6"/>
                        <TextBox x:Name="WebRtcText" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12" MinHeight="96" Padding="10"/>
                        <TextBlock Text="活动连接" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,20,0,6"/>
                        <TextBox x:Name="ConnectionsText" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12" MinHeight="96" Padding="10"/>
                        <TextBlock Text="时区" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,20,0,6"/>
                        <TextBlock x:Name="TimezoneText" Text="出口时区检测中" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TimezoneStatusText" Text="系统时区检测中" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="断网原因" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,20,0,6"/>
                        <TextBlock x:Name="TripReasonText" Text="暂无" TextWrapping="Wrap" Foreground="{StaticResource StatusWarnBrush}" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <wv2:WebView2 x:Name="WebRtcWebView"
                     Visibility="Collapsed"
                     Width="1"
                     Height="1"/>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="LastCheckText" Text="尚未检查" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="IgnoreWebRtcCheckBox"
                          Content="忽略 WebRTC 阻断"
                          Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center"
                          ToolTip="继续显示 WebRTC 检测结果，仅忽略未验证状态；确认泄露时仍会自动断网"
                          Click="IgnoreWebRtcCheckBox_Click"
                          Margin="0,0,14,0"/>
                <Button x:Name="CheckButton" Content="立即检查" Style="{StaticResource PrimaryButtonStyle}" Click="CheckButton_Click" Padding="18,10" Margin="0,0,8,0"/>
                <Button x:Name="RecoverButton" Content="检查并解除阻断" Style="{StaticResource SecondaryButtonStyle}" Click="RecoverButton_Click" Padding="18,10"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

